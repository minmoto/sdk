{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@minmo/core": ["vendor/upstream/core/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "vendor/upstream/**/*.d.ts"]
}
